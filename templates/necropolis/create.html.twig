{% extends 'base.html.twig' %}
{% trans_default_domain 'necropolis' %}
{% block content %}
    {% set breadcrumbs = [
        {title: 'Admin panel' | trans([], 'dashboard'), path: 'admin-dashboard'},
        {title: 'Graves' | trans, path: 'necropolis-list' },
        {title: title}
    ] %}
    {% include 'common/breadcrumbs.html.twig' with breadcrumbs %}
    <div class="admin-panel" id="necropolis">
        <div class="container">
            <div class="section-header text-center wow zoomIn" data-wow-delay="0.1s">
                <h2>{{ title }}</h2>
            </div>
            {{ include('necropolis/_grave_tabs.html.twig') }}
            <div class="tab-content" style="border: 1px solid #dee2e6; padding: 2rem; border-top: 0 none; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
                {{ form_start(form, {attr: {'class': 'form-inline'}}) }}
                <div class="row">
                    <div class="col-lg-8">
                        <div class="row">
                            <div class="col-lg-3">
                                {{ form_row(form.firstName) }}
                            </div>
                            <div class="col-lg-3">
                                {{ form_row(form.lastName) }}
                            </div>
                            <div class="col-lg-3">
                                {{ form_row(form.maidenName) }}
                            </div>
                            <div class="col-lg-3">
                                {{ form_row(form.gender) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-6">
                                {{ form_row(form.birthDate) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.deathDate) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-6">
                                {{ form_row(form.birthPlace) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.birthPlaceCoordinates) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-6">
                                {{ form_row(form.deathPlace) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.deathPlaceCoordinates) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-4">
                                {{ form_row(form.gravePlace) }}
                            </div>
                            <div class="col-lg-4">
                                {{ form_row(form.gravePlaceCoordinates) }}
                            </div>
                            <div class="col-lg-4">
                                {{ form_row(form.epitaph) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-12">
                                {{ form_row(form.biography) }}
                            </div>
                        </div>
    
                        <div class="row">
                            <div class="col-lg-12">
                                {{ form_row(form.isPublished) }}
                            </div>
                        </div>
    
                        <div class="row pt-4">
                            <div class="col-lg-12">
                                <button type="submit" class="btn btn-primary">{{ submit }}</button>
                            </div>
                        </div>
                    </div>
    
                    <div class="col-lg-4">
                        {% if grave is defined and grave.image %}
                            <img src="/necropolis/{{ grave.image }}" alt="" class="img-fluid mb-3 img-thumbnail" />
                        {% endif %}
                        {{ form_row(form.image) }}
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}