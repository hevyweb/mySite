{% extends 'base.html.twig' %}
{% trans_default_domain 'necropolis' %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('js/admin') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('css/necropolis-admin') }}
{% endblock %}

{% block content %}
    {% set breadcrumbs = [
        {title: 'Admin panel' | trans([], 'dashboard'), path: 'admin-dashboard'},
        {title: 'Graves' | trans }
    ] %}
    {% include 'common/breadcrumbs.html.twig' with breadcrumbs %}

    <div class="admin-panel" id="necropolis">
        <div class="container">
            <div class="section-header text-center wow zoomIn" data-wow-delay="0.1s">
                <h2>{{ title }}</h2>
            </div>

            {{ include('necropolis/_grave_tabs.html.twig') }}

            <div class="tab-content" style="border: 1px solid #dee2e6; padding: 2rem; border-top: 0 none; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
                {% if grave.getCondolences is not empty %}
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 5%;">#</th>
                                <th scope="col" style="width: 20%;">{% trans %}Author{% endtrans %}</th>
                                <th scope="col" style="width: 40%;">{% trans %}Description{% endtrans %}</th>
                                <th scope="col" style="width: 15%;">{% trans %}Date{% endtrans %}</th>
                                <th scope="col" style="width: 10%;">{% trans %}Status{% endtrans %}</th>
                                <th scope="col" style="width: 10%;" class="text-end">{% trans %}Actions{% endtrans %}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for condolence in grave.getCondolences %}
                                <tr>
                                    <td>{{ condolence.getId }}</td>
                                    <td>
                                        <div class="fw-bold">{{ condolence.getName|default('Anonymous'|trans) }}</div>
                                        {% if condolence.getEmail %}
                                            <small class="text-muted"><i class="fa-regular fa-envelope me-1"></i>{{ condolence.getEmail }}</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ condolence.getDescription|nl2br }}
                                    </td>
                                    <td>
                                        {% if condolence.getCreationDate %}
                                            <small><i class="fa-regular fa-clock me-1"></i>{{ condolence.getCreationDate|date('Y-m-d H:i') }}</small>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if condolence.isActive %}
                                            <span class="badge bg-success">{% trans %}Active{% endtrans %}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{% trans %}Hidden{% endtrans %}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            {# Toggle Status Action Button #}
                                            {% if condolence.isActive %}
                                                <a href="{{ path('necropolis-condolences-toggle-status', {id: grave.getId, condolenceId: condolence.getId}) }}"
                                                   class="btn btn-outline-warning"
                                                   title="{% trans %}Deactivate{% endtrans %}">
                                                    <i class="fa-solid fa-eye-slash"></i>
                                                </a>
                                            {% else %}
                                                <a href="{{ path('necropolis-condolences-toggle-status', {id: grave.getId, condolenceId: condolence.getId}) }}"
                                                   class="btn btn-outline-success"
                                                   title="{% trans %}Activate{% endtrans %}">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            {% endif %}

                                            {# Delete Action Button #}
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteCondolenceModal-{{ condolence.getId }}"
                                                    title="{% trans %}Delete{% endtrans %}">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>

                                        {# DELETE CONFIRMATION MODAL #}
                                        <div class="modal fade text-start" id="deleteCondolenceModal-{{ condolence.getId }}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                                <div class="modal-content text-center">
                                                    <div class="modal-body p-4">
                                                        <i class="fa-solid fa-triangle-exclamation text-warning fa-3x mb-3"></i>
                                                        <h5>{% trans %}Are you sure?{% endtrans %}</h5>
                                                        <p class="text-muted small">{% trans %}Do you really want to delete this condolence? This action cannot be undone.{% endtrans %}</p>
                                                        <div class="d-flex justify-content-center gap-2 mt-3">
                                                            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
                                                            <a href="{{ path('necropolis-condolences-delete', {id: grave.getId, condolenceId: condolence.getId}) }}" class="btn btn-danger btn-sm">
                                                                <i class="fa-solid fa-trash me-1"></i> {% trans %}Delete{% endtrans %}
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5 text-muted">
                        <i class="fa-regular fa-comments fa-3x mb-3"></i>
                        <p class="mb-0">{% trans %}No condolences have been added yet.{% endtrans %}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}