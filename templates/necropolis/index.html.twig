{% extends 'base.html.twig' %}
{% trans_default_domain 'necropolis' %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('js/admin') }}
{% endblock %}
{% block content %}
    {% set breadcrumbs = [
        {title: 'Admin panel' | trans([], 'dashboard'), path: 'admin-dashboard'},
        {title: 'Graves' | trans }
    ] %}
    {% include 'common/breadcrumbs.html.twig' with breadcrumbs %}
    <div class="admin-panel" id="necropolis">
        <div class="container">
            <div class="section-header text-center wow zoomIn" data-wow-delay="0.1s">
                <h2>{% trans %}Graves{% endtrans %}</h2>
            </div>
            <div class="pb-4">
                {# Adjusted path assumed for creating a new record #}
                <a href="{{ path('necropolis-create') }}" class="btn btn-lg btn-success text-right">
                    <i class="fa-regular fa-file-lines"></i>
                    {% trans from 'messages' %}Create{% endtrans %}
                </a>
                <button class="btn btn-lg btn-danger delete" id="remove-grave" data-confirm="{% trans %}Are you sure that you want to remove selected records from your necropolis?{% endtrans %}">
                    <i class="fa-solid fa-trash-can"></i>
                    {% trans from 'messages' %}Delete{% endtrans %}
                </button>
            </div>
            <div class="row">
                <form action="{{ url('necropolis-delete') }}" method="post" class="datagrid-form">
                    <table class="table table-striped" id="necropolis-table">
                        <thead>
                        <tr>
                            <th>
                                <label><input type="checkbox" class="check-all" /></label>
                            </th>
                            <th>{% trans from 'messages' %}Image{% endtrans %}</th>
                            <th>{% trans %}First Name{% endtrans %}</th>
                            <th>{% trans %}Last Name{% endtrans %}</th>
                            <th>{% trans %}Maiden Name{% endtrans %}</th>
                            <th>{% trans %}Birth Date{% endtrans %}</th>
                            <th>{% trans %}Death Date{% endtrans %}</th>
                            <th>{% trans %}Birth Place{% endtrans %}</th>
                            <th>{% trans %}Death Place{% endtrans %}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for grave in graves %}
                            <tr>
                                <td>
                                    <label><input type="checkbox" name="id[{{ grave.id }}]" /></label>
                                </td>
                                <td>
                                    {% if grave.image %}
                                        <a href="{{ path('necropolis-edit', {'id': grave.id}) }}">
                                            <img src="{{ absolute_url('/necropolis/' ~ grave.image) }}" class="img-thumbnail company-thumbnail" alt="" />
                                        </a>
                                    {% endif %}
                                </td>
                                {# Added UUID link routing to edit view #}
                                <td><a href="{{ path('necropolis-edit', {'id': grave.id}) }}">{{ grave.firstName }}</a></td>
                                <td>{{ grave.lastName }}</td>
                                <td>{{ grave.maidenName ?? '-' }}</td>
                                <td>
                                    {{ grave.birthDate ? grave.birthDate|date('d.m.Y') : '-' }}
                                </td>
                                <td>
                                    {{ grave.deathDate|date('d.m.Y') }}
                                </td>
                                <td>{{ grave.birthPlace ?? '-' }}</td>
                                <td>{{ grave.deathPlace ?? '-' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
    </div>
{% endblock %}