{% set tabs = [] %}
{% if id %}
    {% set mainTab = {
        label: 'Grave details'|trans('necropolis'),
        url: path('necropolis-edit', { id: id }),
        active: request.attributes.get('_route') == 'necropolis-edit',
        icon: 'fa fa-pencil'
    } %}
    {% set photoTab = {
        label: 'Image'|trans('necropolis'),
        url: path('necropolis-photos', { id: id }),
        active: request.attributes.get('_route') == 'necropolis-photos',
        icon: 'fa fa-image'
    } %}
    {% set condolenceTab = {
        label: 'Condolences'|trans('necropolis'),
        url: path('necropolis-condolences', { id: id }),
        active: request.attributes.get('_route') == 'necropolis-condolences',
        icon: 'fa fa-heart'
    } %}
    {% set flowersTab = {
        label: 'Flowers'|trans('necropolis'),
        url: path('necropolis-flowers', { id: id }),
        active: request.attributes.get('_route') == 'necropolis-flowers',
        icon: 'fa fa-gift'
    } %}
    {% set tabs = [mainTab, photoTab, condolenceTab, flowersTab] %}
{% endif %}
{{ tabs|json_encode }}
